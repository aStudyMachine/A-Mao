<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>cn.studymachine</groupId>
    <artifactId>A-Mao</artifactId>
    <version>1.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <properties>
        <maven.compiler.release>25</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <!--依赖组件版本号-->

        <maven-compiler-plugin.version>3.16.0</maven-compiler-plugin.version>
        <hutool-all.version>5.8.27</hutool-all.version>

        <!--spring boot-->
        <spring-boot.version>4.0.8</spring-boot.version>
        <!--spring cloud (alibaba)-->
        <spring.cloud.version>2025.1.0</spring.cloud.version>
        <alibaba.cloud.version>2025.1.0.0</alibaba.cloud.version>

        <!--mapstruct-->
        <mapstruct.version>1.6.3</mapstruct.version>
        <lombok-mapstruct-binding.version>0.2.0</lombok-mapstruct-binding.version>

        <!--mybatis-plus-->
        <mybatis-plus.version>3.5.17</mybatis-plus.version>

        <!-- dynamic-datasource-->
        <dynamic-ds.version>4.5.0</dynamic-ds.version>

        <redisson.version>4.7.0</redisson.version>

    </properties>

    <modules>
        <module>amao-common</module>
        <module>amao-cloud</module>
        <module>amao-boot</module>
        <module>amao-modules</module>
    </modules>

    <dependencyManagement>
       <dependencies>

           <!--region 项目内部模块-->
           <dependency>
               <groupId>cn.studymachine</groupId>
               <artifactId>amao-common-core</artifactId>
               <version>1.0-SNAPSHOT</version>
           </dependency>


           <dependency>
               <groupId>cn.studymachine</groupId>
               <artifactId>amao-common-datasource</artifactId>
               <version>1.0-SNAPSHOT</version>
           </dependency>

           <dependency>
               <groupId>cn.studymachine</groupId>
               <artifactId>amao-common-web</artifactId>
               <version>1.0-SNAPSHOT</version>
           </dependency>

           <dependency>
               <groupId>cn.studymachine</groupId>
               <artifactId>amao-common-redis</artifactId>
               <version>1.0-SNAPSHOT</version>
           </dependency>

           <dependency>
               <groupId>cn.studymachine</groupId>
               <artifactId>amao-common-tracelog</artifactId>
               <version>1.0-SNAPSHOT</version>
           </dependency>

           <!--endregion-->

           <dependency>
               <groupId>org.springframework.boot</groupId>
               <artifactId>spring-boot-dependencies</artifactId>
               <version>${spring-boot.version}</version>
               <type>pom</type>
               <scope>import</scope>
           </dependency>

           <dependency>
               <groupId>org.springframework.cloud</groupId>
               <artifactId>spring-cloud-dependencies</artifactId>
               <version>${spring.cloud.version}</version>
               <type>pom</type>
               <scope>import</scope>
           </dependency>
           <dependency>
               <groupId>com.alibaba.cloud</groupId>
               <artifactId>spring-cloud-alibaba-dependencies</artifactId>
               <version>${alibaba.cloud.version}</version>
               <type>pom</type>
               <scope>import</scope>
           </dependency>

           <dependency>
               <groupId>org.mapstruct</groupId>
               <artifactId>mapstruct</artifactId>
               <version>${mapstruct.version}</version>
           </dependency>
           <dependency>
               <groupId>org.mapstruct</groupId>
               <artifactId>mapstruct-processor</artifactId>
               <version>${mapstruct.version}</version>
           </dependency>
           <dependency>
               <groupId>org.projectlombok</groupId>
               <artifactId>lombok-mapstruct-binding</artifactId>
               <version>${lombok-mapstruct-binding.version}</version>
           </dependency>

           <dependency>
               <groupId>com.baomidou</groupId>
               <artifactId>mybatis-plus-spring-boot4-starter</artifactId>
               <version>${mybatis-plus.version}</version>
           </dependency>

           <!-- MP 3.5.9+ 分页等插件拆分为可选依赖 -->
           <dependency>
               <groupId>com.baomidou</groupId>
               <artifactId>mybatis-plus-jsqlparser</artifactId>
               <version>${mybatis-plus.version}</version>
           </dependency>

           <dependency>
               <groupId>com.baomidou</groupId>
               <artifactId>dynamic-datasource-spring-boot4-starter</artifactId>
               <version>${dynamic-ds.version}</version>
           </dependency>


           <dependency>
               <groupId>org.redisson</groupId>
               <artifactId>redisson-spring-boot-starter</artifactId>
               <version>${redisson.version}</version>
           </dependency>
           <dependency>
               <groupId>cn.studymachine</groupId>
               <artifactId>amao-common-json</artifactId>
               <version>1.0-SNAPSHOT</version>
           </dependency>
           <dependency>
               <groupId>cn.studymachine</groupId>
               <artifactId>amao-common-satoken</artifactId>
               <version>1.0-SNAPSHOT</version>
           </dependency>
           <dependency>
               <groupId>cn.studymachine</groupId>
               <artifactId>amao-cloud-nacos</artifactId>
               <version>1.0-SNAPSHOT</version>
           </dependency>
           <dependency>
               <groupId>cn.studymachine</groupId>
               <artifactId>amao-module-user-api</artifactId>
               <version>1.0-SNAPSHOT</version>
           </dependency>
           <dependency>
               <groupId>cn.studymachine</groupId>
               <artifactId>amao-module-user-service</artifactId>
               <version>1.0-SNAPSHOT</version>
           </dependency>
           <dependency>
               <groupId>cn.studymachine</groupId>
               <artifactId>amao-module-system-api</artifactId>
               <version>1.0-SNAPSHOT</version>
           </dependency>
           <dependency>
               <groupId>cn.studymachine</groupId>
               <artifactId>amao-module-system-service</artifactId>
               <version>1.0-SNAPSHOT</version>
           </dependency>
       </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>${maven-compiler-plugin.version}</version>
                    <configuration>
                        <release>25</release>
                        <!-- JDK 23+ 默认禁用隐式注解处理, 显式开启以支持 lombok -->
                        <proc>full</proc>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>


    <dependencies>

        <!--全局引入的两个组件库 lombok , hutool-->
        <dependency>
            <groupId>cn.hutool</groupId>
            <artifactId>hutool-all</artifactId>
            <version>${hutool-all.version}</version>
        </dependency>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <scope>provided</scope>
        </dependency>

    </dependencies>
</project>