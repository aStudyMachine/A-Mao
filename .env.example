# =====================================================================
# A-Mao 本机开发环境配置（模板）
#
# 用法：复制本文件为同目录下的 .env，按本机实际路径逐项填写。
#   Windows:  Copy-Item .env.example .env
#   Linux:    cp .env.example .env
# 填写完成后执行 .\init.ps1 完成初始化（详见 docs/开发环境搭建.md）。
#
# 约定：.env 是每台设备私有的机器事实，永不入库（.gitignore 已覆盖）；
#       本模板入库，只承载字段说明与示例值。
# 格式：KEY=VALUE，一行一项；# 开头为注释；值不要加引号。
# =====================================================================

# ---- 必填（缺一即快速失败，不做静默回退）----

# JDK 25 安装目录（不含 \bin）。显式声明以避免多设备间 JDK 版本漂移。
JDK_HOME=D:\dev\Java\jdk-25

# Maven 依赖本地仓库落点。留空会静默回落 C 盘默认仓库，故必填。
MAVEN_REPO_LOCAL=D:\dev\Maven\repository

# ---- 建议填（留空则保持 Maven Wrapper 默认 %USERPROFILE%\.m2）----

# Wrapper 分发包（Maven 本体安装包）落点。
# 注意：仅影响分发包，不影响依赖仓库（后者只由 MAVEN_REPO_LOCAL 决定）。
MAVEN_USER_HOME=D:\dev\Maven\userhome

# Wrapper 下载 Maven 分发包所用的镜像基址（仅影响"下载 Maven 本体"）。
# 留空走官方 repo.maven.apache.org；镜像失效时删除本行即可回退。
MVNW_REPOURL=https://maven.aliyun.com/repository/public

# ---- 可选 ----

# 依赖下载镜像，由 init.ps1 写入生成的 settings.xml 的 <mirrors>；留空则整段省略。
# 必须用 https 现行地址（旧 http:// 域名会被 Maven 3.9 阻断，见踩坑记录 通-10）。
# 若内嵌私服凭据（如 user:pass@host），本文件更不得入库。
MAVEN_MIRROR_URL=https://maven.aliyun.com/repository/public

# 本机已安装的 Maven 目录（可选）。仅在生成的 settings 不存在时，
# 用于复用其 conf\settings.xml（见踩坑记录 通-10）。
MAVEN_HOME=

# 显式指定 settings.xml 路径（优先级最高：填了则不再探测、也不生成）。
MAVEN_SETTINGS=

# ---- 中间件宿主端口（可选；留空/注释掉即用默认值）----
# 为什么放这里：宿主端口在本机是否**可用**，取决于 WinNAT/Hyper-V 的动态保留
#   区间（各设备不同、随重启变化），属机器私有事实，不该硬编码进仓库。
# 自查：netsh interface ipv4 show excludedportrange protocol=tcp
# 症状：容器 healthy 但应用连不上 → 登录失败（HTTP 200 + 「用户名或密码错误」）；
#   见 docs\踩坑记录.md 通-17。
# 改动后：执行 .\init.ps1 -Stage Middleware 让 compose 用新端口重建容器。
# 默认值定义点：scripts\local-env.ps1::Get-MiddlewareDefaultPorts
# 注意：NACOS_GRPC_PORT 必须 = NACOS_HTTP_PORT + 1000（nacos-client 规则）。
#MYSQL_HOST_PORT=13306
#REDIS_HOST_PORT=16379
#NACOS_HTTP_PORT=18848
#NACOS_GRPC_PORT=19848
