<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>cn.studymachine</groupId>
        <artifactId>amao-module-system</artifactId>
        <version>1.0-SNAPSHOT</version>
    </parent>

    <artifactId>amao-module-system-service</artifactId>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <description>
        系统模块服务
    </description>

    <dependencies>
        <dependency>
            <groupId>cn.studymachine</groupId>
            <artifactId>amao-module-system-api</artifactId>
            <version>1.0-SNAPSHOT</version>
        </dependency>

        <dependency>
            <groupId>cn.studymachine</groupId>
            <artifactId>amao-common-datasource</artifactId>
        </dependency>

        <dependency>
            <groupId>cn.studymachine</groupId>
            <artifactId>amao-common-web</artifactId>
        </dependency>

        <dependency>
            <groupId>cn.studymachine</groupId>
            <artifactId>amao-common-redis</artifactId>
        </dependency>

        <dependency>
            <groupId>cn.studymachine</groupId>
            <artifactId>amao-common-satoken</artifactId>
        </dependency>

        <dependency>
            <groupId>cn.studymachine</groupId>
            <artifactId>amao-module-user-api</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.mapstruct</groupId>
            <artifactId>mapstruct</artifactId>
        </dependency>
        <dependency>
            <groupId>org.mapstruct</groupId>
            <artifactId>mapstruct-processor</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok-mapstruct-binding</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- Mockito 5.x 默认使用 inline mock maker；JDK 21+（JEP 451）禁止库自行动态挂载 agent，
                 需把 mockito-core 显式作为 -javaagent 传给测试 JVM（Mockito 文档 §0.3 做法）。
                 properties goal 把 jar 绝对路径写入 ${org.mockito:mockito-core:jar}，避免写死版本；
                 版本由根 pom pluginManagement 统一管理。 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <executions>
                    <execution>
                        <id>resolve-mockito-agent</id>
                        <goals>
                            <goal>properties</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <argLine>-javaagent:${org.mockito:mockito-core:jar}</argLine>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>